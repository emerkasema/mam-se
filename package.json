{
  "name": "mam-se",
  "version": "0.7.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.13.0",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "check": "bun run lint && bun run typecheck",
    "test": "node --test tests/data/*.test.ts",
    "test:e2e": "playwright test",
    "build:integration": "astro build --root tests/integration/astro",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@evolu/common": "8.27.2",
    "@evolu/web": "3.7.1",
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@evolu/relay": "4.3.3",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "workbox-build": "7.4.1"
  }
}
